# Test one device
SNMP_HOST=192.168.88.10
SNMP_NAME=Main OLT
SNMP_VERSION=2c
SNMP_PORT=161
SNMP_COMMUNITY=public
SNMP_TIMEOUT_MS=3000
SNMP_RETRIES=1

# Automatic background monitor (temporary static source until dashboard rules are connected)
SNMP_MONITOR_INTERVAL_MS=60000
SNMP_TARGETS_JSON=[{"id":"olt-1","name":"Main OLT","host":"192.168.88.10","version":"2c","community":"public","snmp_enabled":true,"alert_link_down":true,"min_interface_speed_mbps":100}]

