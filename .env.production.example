# Billflow Bridge production authentication
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT.supabase.co/functions/v1
BRIDGE_AUTH_URL=https://YOUR_PROJECT.supabase.co/functions/v1/bridge-auth

TENANT_ID=
INSTALLATION_ID=
DEVICE_SECRET=
BRIDGE_VERSION=1.0.25
BRIDGE_API_VERSION=1

# Runtime services
COMMAND_POLL_ENABLED=true
HEALTH_REPORT_ENABLED=true
BRIDGE_HEALTH_REPORT_URL=https://YOUR_PROJECT.supabase.co/functions/v1/report-bridge-health
TERMINAL_PORT=3066

# Local RouterOS access
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_PORT=22
MIKROTIK_API_PORT=8728

# Local dashboard/API protection
MONITOR_SHARED_SECRET=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
