# Core Bridge
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_FUNCTIONS_URL=
TENANT_ID=
INSTALLATION_ID=
DEVICE_SECRET=
BRIDGE_HW_FINGERPRINT=
BRIDGE_VERSION=
BRIDGE_API_VERSION=1
TERMINAL_PORT=3066

# Local development only. Never enable on production Bridge hosts.
LOCAL_DEV_MODE=false

# MikroTik
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_PORT=22
MIKROTIK_API_PORT=8728

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background monitoring
MONITOR_INTERVAL_MS=30000
MONITOR_RETRY_COUNT=4
MONITOR_CONCURRENCY=10
MONITOR_SHARED_SECRET=
DEVICE_HEALTH_REPORT_ENABLED=true
DEVICE_HEALTH_REPORT_URL=
DEVICE_HEALTH_REPORT_TIMEOUT_MS=10000
DEVICE_HEALTH_REPORT_BATCH_SIZE=100

# SNMP background monitoring
SNMP_MONITOR_ENABLED=true
SNMP_MONITOR_INTERVAL_MS=10000
BRIDGE_MONITORING_CONFIG_URL=
BRIDGE_MONITORING_CONFIG_TIMEOUT_MS=10000
BRIDGE_REPORT_INTERFACES_URL=
BRIDGE_REPORT_INTERFACES_TIMEOUT_MS=10000

# Temporary local-dev SNMP target source only.
# Production uses bridge-monitoring-config instead.
SNMP_TARGETS_JSON=[]

# Production remote command / health services
COMMAND_POLL_ENABLED=true
HEALTH_REPORT_ENABLED=true
BRIDGE_HEALTH_REPORT_URL=

# Update agent
UPDATE_AGENT_URL=
UPDATE_AGENT_SECRET=
UPDATE_AGENT_TIMEOUT_MS=10000

# MikroTik CPU/RAM alerts use the existing RouterOS API credentials above.
# No extra environment variables are required.
